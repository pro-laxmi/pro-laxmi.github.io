---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '@src/layouts/BaseLayout.astro';
import { slugify, unslugify } from '@src/utils';
import PostsByYear from '@src/components/PostsByYear.astro';
import ProjectList from '@src/components/ProjectList.astro';

type BlogPost = CollectionEntry<'blog'>;
export const getStaticPaths = async () => {
	const allPosts: BlogPost[] = await getCollection('blog');
	const allProjects = await getCollection('projects');
	return [
		...new Set([
			...allPosts.map((post) => post.data.tags).flat(),
			...allProjects.map((project) => project.data.tags).flat()
		].filter((tag) => !!tag))
	].map((tag) => ({ params: { tag: slugify(tag || '') } }));
};

const { tag } = Astro.params;
const allPosts: BlogPost[] = (await getCollection('blog')).sort((a, b) => (b.data.pubDate?.valueOf() || b.data.date?.valueOf() || 0) - (a.data.pubDate?.valueOf() || a.data.date?.valueOf() || 0));
const taggedPosts = allPosts.filter((post) => post.data.tags?.map((t) => slugify(t)).includes(tag || ''));

const allProjects = (await getCollection('projects')).sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0)).map(p => ({
  name: p.data.title,
  description: p.data.summary || '',
  demoLink: p.data.links?.[0]?.url || '',
  html_url: p.data.github || '',
  tags: p.data.tags || [],
  postLink: `/projects/${p.id}/`
}));
const taggedProjects = allProjects.filter((project) => project.tags?.map((t) => slugify(t)).includes(tag || ''));

const title = `All Items Tagged with ${unslugify(tag || '')}`;
const description = `All Items Tagged with ${unslugify(tag || '')}`;
---

<BaseLayout
	title={title}
	description={description}
>
  <div class='container'>
    <div class="mb-10">
      <h1 class="text-3xl font-bold mb-2">{title}</h1>
    </div>
    
    {taggedProjects.length > 0 && (
      <div class="mb-12">
        <h2 class="text-2xl font-bold mb-6 border-b dark:border-b-zinc-700 pb-2">Projects</h2>
        <ProjectList projects={taggedProjects}/>
      </div>
    )}
    
    {taggedPosts.length > 0 && (
      <div>
        <h2 class="text-2xl font-bold mb-6 border-b dark:border-b-zinc-700 pb-2">Posts</h2>
        <PostsByYear posts={taggedPosts}/>
      </div>
    )}
  </div>
</BaseLayout>
