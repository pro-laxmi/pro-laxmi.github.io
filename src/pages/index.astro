---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, NEWS } from '../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Ava from '@src/assets/img/me.jpeg';
import Prose from '../components/Prose.astro';
import ProjectList from '../components/ProjectList.astro'
import PostItem from '../components/PostItem.astro';
import { Mail, MapPin, Linkedin, Github, FileText, Briefcase, Building } from 'lucide-astro';

type BlogPost = CollectionEntry<'blog'>;

const projectsCollection = await getCollection('projects');
const top6Projects = projectsCollection.sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0)).slice(0, 6).map(p => ({
  name: p.data.title,
  description: p.data.summary || '',
  demoLink: p.data.links?.[0]?.url || '',
  html_url: p.data.github || '',
  tags: p.data.tags || [],
  postLink: `/projects/${p.id}/`,
  date: p.data.date
}));
const posts = (await getCollection('blog')).sort((a: BlogPost, b: BlogPost) => (b.data.pubDate?.valueOf() || b.data.date?.valueOf() || 0) - (a.data.pubDate?.valueOf() || a.data.date?.valueOf() || 0)).slice(0, 5);

const news = NEWS.slice(0, 5);
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION}>
	<div class='container'>
		<div class='w-full md:flex md:items-center gap-16 mb-10'>
      <div class="text-pretty leading-9">
        <h1 class="text-4xl font-bold mb-4">Laxmidhar Panda</h1>
        <h2 class="text-xl text-zinc-600 dark:text-zinc-300 mb-4 font-mono">Undergraduate <span class="text-cyan-600 dark:text-cyan-400">A.I enthusiast</span>, <span class="text-cyan-600 dark:text-cyan-400">Full Stack Developer</span>, <span class="text-cyan-600 dark:text-cyan-400">Researcher</span></h2>
        <Prose>
          <div class="text-lg text-zinc-700 dark:text-zinc-300">
            <p>Hi! I'm Laxmidhar Panda, a B.Tech. student in Computer Science and Engineering at <a href="https://www.iitgn.ac.in/" target="_blank" class="text-cyan-600 dark:text-cyan-400 hover:underline">IIT Gandhinagar</a>.</p>
            <p>I am deeply interested in building software that solves real life problems and getting to know things from first principles. My philosophy is to know the fundamentals and build upon them not just doing some AI slop. I have some expertise in <span class="text-cyan-600 dark:text-cyan-400">Machine learning</span>, <span class="text-cyan-600 dark:text-cyan-400">Deep learning</span>, and <span class="text-cyan-600 dark:text-cyan-400">Computer Vision</span>, <span class="text-cyan-600 dark:text-cyan-400">Natural Language Processing(NLP)</span>, <span class="text-cyan-600 dark:text-cyan-400">Vector Databasea</span>, <span class="text-cyan-600 dark:text-cyan-400">Web Development</span> and <span class="text-cyan-600 dark:text-cyan-400">RAGs</span>. Lately, I've been exploring more into areas like <span class="text-cyan-600 dark:text-cyan-400">Vector databases</span> and it's effective use in memory for agentic applications to solve the real life problems.</p>
            <p>Outside of development and coding, I enjoy sharpening my communication skills, hitting the gym, and reading philosophy books.</p>
          </div>
        </Prose>
      </div>
      <Image src={Ava} alt="Laxmidhar Panda" width={300} loading="eager" class="rounded-3xl rotate-3 mx-4 md:mx-0 shadow-lg shadow-cyan-900/100"/>
		</div>
    
    <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-zinc-600 dark:text-zinc-400 font-mono mb-12">
      <div class="flex items-center gap-2"><Briefcase size={16}/> IIT Gandhinagar, Gujarat</div>
      <div class="flex items-center gap-2"><MapPin size={16}/> Bhubaneswar, Odisha</div>
      <a href="https://www.linkedin.com/in/laxmidhar-panda/" target="_blank" class="flex items-center gap-2 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"><Linkedin size={16}/> LinkedIn</a>
      <a href="https://github.com/pro-laxmi" target="_blank" class="flex items-center gap-2 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"><Github size={16}/> Github</a>
      <a href="mailto:laxmidharpanda084@gmail.com" class="flex items-center gap-2 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"><Mail size={16}/> Mail me</a>
      <a href="https://drive.google.com/file/d/1WWFLhiALFLdKPy-ZUW_z5TeAGStwi23k/view?usp=sharing" target="_blank" class="flex items-center gap-2 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"><FileText size={16}/> Resume</a>
    </div>

		<main>
      <div class='mt-6 mb-16 flex flex-col md:flex-row gap-8 items-start'>
        <h2 class="text-xl font-bold shrink-0 mt-2">News</h2>
        <div class="relative border-l border-zinc-300 dark:border-zinc-700 pl-8 space-y-8 flex-1 md:ml-32">
          {news.map(item => (
            <div class="relative">
              <div class="absolute -left-[38px] top-1.5 w-3 h-3 bg-zinc-400 dark:bg-zinc-500 rounded-full border-4 border-white dark:border-[#111111]"></div>
              <div class="absolute -left-32 top-1 text-xs font-mono text-zinc-600 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800/30 border border-zinc-200 dark:border-zinc-700/50 px-2 py-1.5 rounded w-24 text-center hidden md:block">
                {item.date.split(', ')[0]},<br/>{item.date.split(', ')[1]}
              </div>
              <div class="md:hidden text-sm font-mono text-zinc-600 dark:text-zinc-400 mb-1">{item.date}</div>
              <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed text-sm md:text-base" set:html={item.content}></p>
            </div>
          ))}
          <div class="pt-4">
            <a href="/news/" class="text-sm font-mono text-zinc-600 dark:text-zinc-400 hover:text-cyan-600 dark:hover:text-cyan-400 underline underline-offset-4">See all »</a>
          </div>
        </div>
      </div>
      <div class='mt-6 mb-12'>
        <div class="flex justify-between gap-2 border-b mb-1 dark:border-b-zinc-700">
          <h2 class="text-lg font-bold mb-3">Recent Posts</h2>
          <a href="/posts/" class="inline-block py-2 underline dark:prose-invert">All posts &raquo;</a>
        </div>
        <div>
          {
            posts.map((post: BlogPost) => (
              <PostItem post={post} />
            ))
          }      
        </div>
        <div class="text-right">
        </div>
      </div>
      <div>
        <div class="flex justify-between gap-2 mb-1">
          <h2 class="text-lg font-bold mb-3">My Projects</h2>
          <a href="/projects/" class="inline-block py-2 underline dark:prose-invert">All projects &raquo;</a>
        </div>
        <ProjectList projects={top6Projects}/>
      </div>
		</main>
	</div>
</BaseLayout>
